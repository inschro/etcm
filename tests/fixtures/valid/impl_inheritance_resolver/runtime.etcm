spec Runtime:
  tags: list[str] = [] [override="append"]
  metadata: dict[str, str] = {} [override="merge"]
  device: str = "cpu" [override="allow"]

  impl base:
    tags: ["base"]
    metadata: {"owner": "tests"}

  impl child <- base:
    tags: ["child"]
    metadata: {"mode": "fast"}
    device: "cuda"
